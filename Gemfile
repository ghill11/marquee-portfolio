# Gemfile for local Jekyll builds (e.g. by alumni after graduation).
# GitHub Pages itself uses its own pinned dependency set and ignores this
# file, so changes here do not affect production builds.
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "jekyll-include-cache", group: :jekyll_plugins

# Windows / JRuby compatibility
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
gem "wdm", "~> 0.1.1", platforms: [:mingw, :mswin, :x64_mingw]
